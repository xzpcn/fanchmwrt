# FanchmWrt / Xiaomi Mi Router 3 Pro (ramips mt7621, 256MiB NAND, 512MiB RAM)
# 复制为 .config 后执行 make defconfig，其余项由 kconfig 默认值补齐。
#
# 镜像容量由 target 决定，不在本文件里设置：
#   target/linux/ramips/image/mt7621.mk -> Device/xiaomi_mi-router-3-pro
#     IMAGE_SIZE := 255488k   (= kernel 4096k + ubi 245,5MiB，正对 256MiB NAND)
#     KERNEL_SIZE := 4096k    (来自 Device/nand，对应 dts 里的 "kernel" 分区)
#   128MiB 那档是 Mi Router 3G：IMAGE_SIZE := 124416k。

# ---- 目标平台 ----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3-pro=y

# ---- 界面 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-fanchmwrt=y

# ---- sing-box-extended ----
CONFIG_PACKAGE_sing-box-extended=y
CONFIG_SING_BOX_EXTENDED_CLASH_API=y
CONFIG_SING_BOX_EXTENDED_GVISOR=y
CONFIG_SING_BOX_EXTENDED_QUIC=y
CONFIG_SING_BOX_EXTENDED_UTLS=y
CONFIG_SING_BOX_EXTENDED_WIREGUARD=y

# mt7621 是 mipsel，Manager API 用不了：
# with_manager 的存储层 modernc.org/sqlite 只实现了 linux/{386,amd64,arm,
# arm64,loong64,ppc64le,riscv64,s390x} 和 darwin/freebsd/windows 等，32 位 mips
# 下一行实现都没有（它依赖的 modernc.org/libc 也只有 mips64le），
# go build 会直接报 build constraints exclude all Go files ... / undefined: sqlite3.X...
# （上游 .goreleaser.yaml 的 mips / openwrt-mips 目标同样不带 with_manager）。
# 所以这里不要打开 MANAGER / ADMIN_PANEL，包内 Makefile 也会在 mips 上
# 自动忽略它们；想用管理面板请换 arm64 / x86_64 设备。
CONFIG_SING_BOX_EXTENDED_MANAGER=n
CONFIG_SING_BOX_EXTENDED_ADMIN_PANEL=n

# 构建时拉 geoip-cn.srs / geosite-cn.srs 装进 /usr/share/sing-box/geo，
# 固件里的分流不依赖运行时访问 GitHub。关掉它必须同时删掉 config.json 里的
# rule_set 与两条引用它的 route 规则，否则 sing-box 起不来。
CONFIG_SING_BOX_EXTENDED_GEORULES=y
# 体积较大，按需打开
CONFIG_SING_BOX_EXTENDED_ACME=y
CONFIG_SING_BOX_EXTENDED_TAILSCALE=y
CONFIG_SING_BOX_EXTENDED_OPENVPN=y
CONFIG_SING_BOX_EXTENDED_OPENCONNECT=y
CONFIG_SING_BOX_EXTENDED_CLOUDFLARED=y
# with_grpc / with_v2ray_api 不在上游任何一份 tag 列表里，默认不开
CONFIG_SING_BOX_EXTENDED_GRPC=n
CONFIG_SING_BOX_EXTENDED_V2RAY_API=n

# 显式声明依赖，避免 defconfig 在个别分支上漏装
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-queue=y

# ---- 常用补充 ----
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ---- 构建日志 ----
# CONFIG_BUILD_LOG 在 Kconfig 里是 "bool ... if DEVEL"，没有 DEVEL 时
# make defconfig 会把它悄悄丢掉，于是 logs/ 不会生成、失败时没有任何按包
# 日志。CI 里必须一起打开 DEVEL。
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
