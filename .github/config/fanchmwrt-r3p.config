# FanchmWrt / Xiaomi Mi Router 3 Pro (ramips mt7621, 128MB NAND)
# 复制为 .config 后执行 make defconfig，其余项由 kconfig 默认值补齐。

# ---- 目标平台 ----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3-pro=y

# ---- 界面 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-fanchmwrt=y

# ---- sing-box-extended ----
CONFIG_PACKAGE_sing-box-extended=y
CONFIG_SING_BOX_EXTENDED_MANAGER=y
CONFIG_SING_BOX_EXTENDED_ADMIN_PANEL=y
CONFIG_SING_BOX_EXTENDED_CLASH_API=y
CONFIG_SING_BOX_EXTENDED_GVISOR=y
CONFIG_SING_BOX_EXTENDED_QUIC=y
CONFIG_SING_BOX_EXTENDED_UTLS=y
CONFIG_SING_BOX_EXTENDED_WIREGUARD=y
# 体积较大，按需打开
CONFIG_SING_BOX_EXTENDED_ACME=n
CONFIG_SING_BOX_EXTENDED_TAILSCALE=n
CONFIG_SING_BOX_EXTENDED_OPENVPN=n
CONFIG_SING_BOX_EXTENDED_OPENCONNECT=n
CONFIG_SING_BOX_EXTENDED_CLOUDFLARED=n
CONFIG_SING_BOX_EXTENDED_GRPC=n
CONFIG_SING_BOX_EXTENDED_V2RAY_API=n

# 显式声明依赖，避免 defconfig 在个别分支上漏装
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-queue=y

# ---- 常用补充 ----
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y
